# Application env variables
APP_VERSION=1.0.0
# Logger env variables
LOGGER_ENV=local
# HTTP server env variables
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=35s
HTTP_IDLE_TIMEOUT=120s
# Middleware env variables
MIDDLEWARE_REQUEST_TIMEOUT=30s
MIDDLEWARE_LIM_REQUESTS=100
MIDDLEWARE_LIM_PERIOD=1m
MIDDLEWARE_CORS_ALLOWED_ORIGINS=*
# Worker env variables
WORKER_CONCURRENCY=10
WORKER_ORDER_CLEANER_CRON=@every 15m
WORKER_ROLE_CLEANER_CRON=@every 1h
WORKER_PENDING_ORDER_TTL=1h
# Postgres env variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=2food
POSTGRES_SSLMODE=disable
# Redis env variables
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=canbeempty
REDIS_DB=0
# JWT env variables
JWT_SECRET=secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_PRE_AUTH_TOKEN_TTL=10m
# Phone OTP env variables
PHONE_OTP_LENGTH=6
PHONE_OTP_TTL=5m
PHONE_OTP_KEY_PREFIX=phone_otp:
PHONE_OTP_RATE_LIMIT=3
PHONE_OTP_RATE_PERIOD=1h
PHONE_OTP_RATE_KEY_PREFIX=phone_rate:
# Email OTP env variables
EMAIL_LENGTH=6
EMAIL_OTP_TTL=10m
EMAIL_OTP_KEY_PREFIX=email_otp:
EMAIL_OTP_RATE_LIMIT=3
EMAIL_OTP_RATE_PERIOD=1h
EMAIL_OTP_RATE_KEY_PREFIX=email_rate:
# Twilio env variables
TWILIO_ACCOUNT_SID=sid
TWILIO_AUTH_TOKEN=token
TWILIO_FROM_NUMBER=+1234567890
# SMTP env variables
SMTP_HOST=smtp.host.com
SMTP_PORT=587
SMTP_USERNAME=user
SMTP_PASSWORD=pass
SMTP_FROM="2food <noreply@mail.your.site>"
# OAuth env variables
OAUTH_SESSION_TTL=15m
OAUTH_KEY_PREFIX=oauth:
# Google OAuth
GOOGLE_CLIENT_ID=clientid
# Order env variables
ORDER_PICKUP_CODE_LENGTH=4
DISPLAY_NUMBER_LENGTH=4
# Payment env variables
PAYMENT_CURRENCY=KZT
PAYMENT_AMOUNT_MULTIPLIER=100
# Stripe env variables
STRIPE_SECRET_KEY=sk_test_1234567890
STRIPE_WEBHOOK_SECRET=whsec_1234567890
# Storage env variables
STORAGE_PRESIGN_TTL=5m
# S3 env variables
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=2food
S3_REGION=us-east-1
S3_ACCESS_KEY=accesskey
S3_SECRET_KEY=secretkey
# FCM env variables
FCM_CREDENTIALS_B64=base64_encoded_credentials
# Push queue env variables
PUSH_QUEUE_MAX_RETRIES=3
# Payment queue env variables
PAYMENT_QUEUE_MAX_RETRIES=5